{
  "_meta": {
    "version": "1.0",
    "description": "Design token asset layer — human-curated tiered visual parameters. AI references level names only (get_token), never raw values.",
    "unit": "spacing/radius/type_scale in pt; shadow blur_pt/dist_pt in pt + opacity 0-1; color in hex",
    "palette": "neutral slate + one restrained business blue",
    "modifiable": true
  },
  "spacing": {
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 40
  },
  "radius": {
    "none": 0,
    "sm": 4,
    "md": 8,
    "lg": 16
  },
  "shadow": {
    "sm": { "blur_pt": 4, "dist_pt": 2, "opacity": 0.12 },
    "md": { "blur_pt": 8, "dist_pt": 4, "opacity": 0.18 },
    "lg": { "blur_pt": 16, "dist_pt": 8, "opacity": 0.25 }
  },
  "type_scale": {
    "xs": 10,
    "sm": 12,
    "md": 16,
    "lg": 20,
    "xl": 28,
    "xxl": 36
  },
  "color": {
    "bg": "#FFFFFF",
    "surface": "#F4F6F9",
    "muted": "#94A3B8",
    "border": "#E2E8F0",
    "ink": "#0F172A",
    "ink_soft": "#475569",
    "accent": "#1D4ED8",
    "accent_soft": "#E8EEFC",
    "on_accent": "#FFFFFF"
  }
}
