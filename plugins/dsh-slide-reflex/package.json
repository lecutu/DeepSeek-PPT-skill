{
  "name": "dsh-slide-reflex",
  "version": "0.1.0",
  "description": "Vision-free PPT engine bridge + live per-page preview panel",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./typert": "./lib/typert.js",
    "./remote": "./lib/remote.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/typert.js",
    "lib/remote.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "ppt",
    "pptx",
    "presentation",
    "slides"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lecutu/DeepSeek-PPT-skill.git",
    "directory": "plugins/dsh-slide-reflex"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "zod": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresRestart": true,
      "requiresBuildApproval": false,
      "manualSteps": "Requires ppt-reflex engine repo with _dsh_ppt_runner.py"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
